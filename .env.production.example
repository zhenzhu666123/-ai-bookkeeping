# 生产环境配置模板
# 复制成 .env，填上真实值（可从你本地 .env 复制 LLM 相关配置）

APP_NAME=AI 家庭记账系统
DEBUG=false

# 数据库（SQLite 默认，数据在 data/ 目录）
DB_URL=sqlite:///./data/bookkeeping.db

# LLM（OpenAI 兼容协议）—— 换成你自己的
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=sk-你的智谱Key
LLM_MODEL=glm-4
VISION_MODEL=glm-4v
EMBEDDING_MODEL=embedding-3
LLM_TIMEOUT=15
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# 首次启动灌示例数据
SEED_ON_FIRST_RUN=true
