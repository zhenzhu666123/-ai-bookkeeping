# ============================================
# AI 家庭记账系统 · 环境变量示例
# ============================================
# 使用方式：
#   cp .env.example .env
#   # 然后编辑 .env 填入你自己的值
#
# .env 文件不提交到 git（已被 .gitignore 忽略）
# 敏感信息（API Key）只存在本地，不污染代码库


# ============ 应用 ============
# 是否开启调试模式（reload 自动重启）
DEBUG=false


# ============ 数据库 ============
# 开发默认 SQLite（零配置，本地文件）
DB_URL=sqlite:///./data/bookkeeping.db

# 生产环境可切换 MySQL：
# DB_URL=mysql+pymysql://user:password@host:3306/bookkeeping

# 是否打印 SQL 语句（调试用）
DB_ECHO=false


# ============ LLM（OpenAI 兼容 API）============
# 换成你要用的模型：

# --- OpenAI 官方 ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# --- 通义千问 ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus

# --- 智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=xxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=glm-4-flash

# --- 本地 Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# 请求超时秒数
LLM_TIMEOUT=15

# JSON 解析失败时的重试次数
LLM_MAX_RETRIES=2

# 生成温度（结构化任务用低值）
LLM_TEMPERATURE=0.1


# ============ Embedding（RAG 向量化）============
EMBEDDING_MODEL=text-embedding-3-small
# 换 DeepSeek/通义 的 embedding：
# EMBEDDING_MODEL=deepseek-embedding-1
# EMBEDDING_MODEL=text-embedding-v3

# RAG 检索返回的 top-k 结果数
RAG_TOP_K=5

# 余弦相似度阈值（低于此值走关键词兜底）
RAG_SIMILARITY_THRESHOLD=0.3


# ============ 首次启动 ============
# 首次启动是否灌入示例数据（false 用于生产）
SEED_ON_FIRST_RUN=true
